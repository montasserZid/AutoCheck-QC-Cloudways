{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@sparticuz/chromium": ["./types/sparticuz-chromium.stub.d.ts"]
    },
    "plugins": []
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "vendor/src/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
