# Copy to .env on the Cloudways host and fill in real values.
# .env is git-ignored. Never commit the real secret.

# Shared server-to-server credential. Must be identical to the Vercel
# AUTOCHECK_WORKER_SECRET. Use a long random value, e.g.
#   openssl rand -hex 32
AUTOCHECK_WORKER_SECRET=replace-with-a-long-random-secret

# The worker is loopback-only. Do not change this to a public address.
AUTOCHECK_WORKER_HOST=127.0.0.1
AUTOCHECK_WORKER_PORT=3000

# Resource control: 2 vCPU / ~4 GB RAM. 1 keeps a single Chrome at a time.
AUTOCHECK_WORKER_MAX_CONCURRENT=1

# Hard bound on one extraction, including navigation. Keep below the PHP gateway
# read timeout (45s) and below the AutoCheck route budget.
AUTOCHECK_WORKER_EXTRACT_TIMEOUT_MS=25000

# Chrome already present on this host. puppeteer-core never downloads a browser.
CHROME_EXECUTABLE_PATH=/home/master/.cache/puppeteer/chrome/linux-154.0.8037.57/chrome-linux64/chrome

# Required on Cloudways because the account cannot use the Chrome sandbox.
# Do not copy the Vercel/serverless graphics flags here.
AUTOCHECK_CHROME_ARGS=--no-sandbox --disable-setuid-sandbox
