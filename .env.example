NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never prefix with NEXT_PUBLIC_ or expose to browser code.
SUPABASE_SECRET_KEY=sb_secret_...
# Migration tooling only; never read by application code.
SUPABASE_DB_PASSWORD=your-database-password
# Server-only. Cloudways browser worker gateway used by /api/listing-extraction for
# listings that need a real browser. Point at the PHP gateway's extract route, never
# at the worker directly (the worker listens on 127.0.0.1 and is not public).
# Leave AUTOCHECK_WORKER_URL unset to keep the previous in-process behaviour.
AUTOCHECK_WORKER_URL=https://your-host.example.com/worker-gateway.php?route=extract
# Server-only. Must match AUTOCHECK_WORKER_SECRET in the worker's own .env on Cloudways.
AUTOCHECK_WORKER_SECRET=replace-with-the-same-long-random-worker-secret
# Server-only. Bounds the AutoCheck -> worker hop. Keep below the gateway read timeout.
AUTOCHECK_WORKER_TIMEOUT_MS=40000
